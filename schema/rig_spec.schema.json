{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TAK Rig Specification",
  "description": "机器可读的绑定 / 导出 / 引擎映射规范。所有 DCC 与工具共用同一份事实源。",
  "type": "object",
  "required": ["version", "dcc", "naming", "skeleton", "skin", "export"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "description": { "type": "string" },
    "dcc": {
      "type": "object",
      "required": ["targets", "min_versions"],
      "additionalProperties": false,
      "properties": {
        "targets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["maya", "max", "mobu", "unreal"] }
        },
        "min_versions": {
          "type": "object",
          "properties": {
            "maya": { "type": "string" },
            "max": { "type": "string" },
            "mobu": { "type": "string" },
            "unreal": { "type": "string" }
          },
          "additionalProperties": false
        }
      }
    },
    "naming": {
      "type": "object",
      "required": ["joint_pattern", "side_tokens", "control_namespace"],
      "additionalProperties": false,
      "properties": {
        "joint_pattern": { "type": "string", "description": "骨骼命名正则" },
        "side_tokens": { "type": "array", "items": { "type": "string" } },
        "control_namespace": { "type": "string" },
        "forbidden_tokens": { "type": "array", "items": { "type": "string" } },
        "case_sensitive": { "type": "boolean" }
      }
    },
    "skeleton": {
      "type": "object",
      "required": ["required_joints", "max_depth"],
      "additionalProperties": false,
      "properties": {
        "required_joints": { "type": "array", "items": { "type": "string" } },
        "max_depth": { "type": "integer", "minimum": 1 },
        "allow_negative_scale": { "type": "boolean" },
        "allow_frozen_transforms_only": { "type": "boolean" },
        "joint_orient_tolerance_deg": { "type": "number", "minimum": 0 }
      }
    },
    "skin": {
      "type": "object",
      "required": ["max_influences", "weight_sum_tolerance"],
      "additionalProperties": false,
      "properties": {
        "max_influences": { "type": "integer", "minimum": 1, "maximum": 8 },
        "weight_sum_tolerance": { "type": "number", "minimum": 0 },
        "normalize": { "type": "boolean" },
        "allowed_deformers": { "type": "array", "items": { "type": "string" } }
      }
    },
    "export": {
      "type": "object",
      "required": ["fbx"],
      "additionalProperties": false,
      "properties": {
        "fbx": {
          "type": "object",
          "required": ["up_axis", "unit", "bake_animation"],
          "additionalProperties": false,
          "properties": {
            "up_axis": { "enum": ["Y", "Z"] },
            "unit": { "enum": ["cm", "m"] },
            "bake_animation": { "type": "boolean" },
            "include_constraints": { "type": "boolean" },
            "include_meshes": { "type": "boolean" },
            "frame_range": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 }
          }
        },
        "usd": {
          "type": "object",
          "properties": {
            "up_axis": { "enum": ["Y", "Z"] },
            "export_skel": { "type": "boolean" }
          },
          "additionalProperties": false
        }
      }
    },
    "ue": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "skeleton_asset": { "type": "string" },
        "ik_retargeter": { "type": "string" },
        "skeleton_mapping": { "type": "object" },
        "animation_compression": { "type": "string" },
        "allow_mesh_deformer": { "type": "boolean" }
      }
    }
  }
}
