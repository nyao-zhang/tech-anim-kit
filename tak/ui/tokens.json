{
  "version": "1.1.0",
  "description": "TAK 设计系统唯一事实源。修改颜色/间距后运行 python tak/ui/generate_theme.py 重新生成 QSS 与 CSS。",
  "themes": {
    "dark": {
      "bg": "#14161A",
      "surface": "#1C1F25",
      "elevated": "#242830",
      "border": "#333842",
      "border_strong": "#454B58",
      "text": "#E6E8EC",
      "text_muted": "#9AA1AC",
      "text_hint": "#6C7480",
      "accent": "#4C8DFF",
      "accent_soft": "#1E3A5F",
      "accent_text": "#FFFFFF",
      "info": "#5AA9F5",
      "warning": "#E8A33D",
      "error": "#E2574C",
      "success": "#3FBF87",
      "severity_soft": "#2A2E36",
      "table_alt": "#20242B"
    },
    "light": {
      "bg": "#F5F6F8",
      "surface": "#FFFFFF",
      "elevated": "#FFFFFF",
      "border": "#DDE1E7",
      "border_strong": "#C3C9D2",
      "text": "#1F2329",
      "text_muted": "#5C6470",
      "text_hint": "#8A919B",
      "accent": "#2B6CD4",
      "accent_soft": "#E4EEFC",
      "accent_text": "#FFFFFF",
      "info": "#2B6CD4",
      "warning": "#B5760A",
      "error": "#C73A31",
      "success": "#1F8A5B",
      "severity_soft": "#EEF1F5",
      "table_alt": "#F8F9FB"
    }
  },
  "radius": { "sm": 4, "md": 8, "lg": 12 },
  "spacing": { "xs": 4, "sm": 8, "md": 12, "lg": 16, "xl": 24 },
  "font": {
    "family": "'Segoe UI', 'Microsoft YaHei', sans-serif",
    "mono": "'Cascadia Code', Consolas, monospace",
    "size_body": 13,
    "size_title": 15,
    "size_caption": 12,
    "size_display": 21
  }
}
