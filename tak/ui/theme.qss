/* TAK dark theme - generated from tokens.json v1.1.0. DO NOT EDIT. */
QWidget, QMainWindow {
    background-color: #14161A;
    color: #E6E8EC;
    font-family: 'Segoe UI', 'Microsoft YaHei', sans-serif;
    font-size: 13px;
}
QWidget[takCard="true"], QGroupBox, QFrame[takCard="true"] {
    background-color: #1C1F25;
    border: 1px solid #333842;
    border-radius: 12px;
    padding: 12px;
}
QLabel { color: #E6E8EC; background: transparent; }
QLabel[takMuted="true"] { color: #9AA1AC; }
QLabel[takHint="true"] { color: #6C7480; font-size: 12px; }
QPushButton {
    background-color: #242830;
    color: #E6E8EC;
    border: 1px solid #454B58;
    border-radius: 8px;
    padding: 8px 16px;
}
QPushButton:hover { border-color: #4C8DFF; }
QPushButton:pressed { background-color: #1E3A5F; }
QPushButton[takPrimary="true"] {
    background-color: #4C8DFF;
    color: #FFFFFF;
    border: 1px solid #4C8DFF;
}
QLineEdit, QSpinBox, QComboBox, QPlainTextEdit, QTextEdit {
    background-color: #242830;
    color: #E6E8EC;
    border: 1px solid #333842;
    border-radius: 4px;
    padding: 4px 8px;
    selection-background-color: #1E3A5F;
}
QPlainTextEdit { font-family: 'Cascadia Code', Consolas, monospace; }
QTableWidget, QTreeWidget, QListView, QListWidget {
    background-color: #1C1F25;
    alternate-background-color: #20242B;
    color: #E6E8EC;
    border: 1px solid #333842;
    border-radius: 8px;
    gridline-color: #333842;
}
QListWidget { padding: 4px; outline: none; }
QListWidget::item {
    padding: 8px 12px;
    border-radius: 4px;
    color: #9AA1AC;
    border: 1px solid transparent;
}
QListWidget::item:hover { background-color: #242830; color: #E6E8EC; }
QListWidget::item:selected {
    background-color: #1E3A5F;
    color: #E6E8EC;
    border: 1px solid #4C8DFF;
}
QListWidget#takCategoryList::item { padding: 4px 12px; }
QHeaderView::section {
    background-color: #242830;
    color: #9AA1AC;
    border: none;
    border-bottom: 1px solid #333842;
    padding: 8px;
}
QLabel[takSeverity="error"], QLabel[takSeverity="blocker"] { color: #E2574C; }
QLabel[takSeverity="warning"] { color: #E8A33D; }
QLabel[takSeverity="info"] { color: #5AA9F5; }
QLabel[takSeverity="success"] { color: #3FBF87; }
QLabel[takDisplay="true"] { font-size: 21px; font-weight: 600; }
QLabel[takSection="true"] {
    color: #9AA1AC;
    font-size: 12px;
    font-weight: 600;
    padding-top: 8px;
}
QLabel[takBadge="true"] {
    background-color: #2A2E36;
    color: #9AA1AC;
    border: 1px solid #333842;
    border-radius: 4px;
    padding: 2px 8px;
    font-size: 12px;
}
QPushButton[takGhost="true"] {
    background-color: transparent;
    border: 1px solid #333842;
    color: #9AA1AC;
}
QPushButton[takGhost="true"]:hover { color: #E6E8EC; border-color: #4C8DFF; }
QPushButton:disabled { color: #6C7480; border-color: #333842; }
QScrollArea { border: none; background: transparent; }
QScrollArea > QWidget > QWidget { background: transparent; }
QSplitter::handle { background: #333842; }
QSplitter::handle:horizontal { width: 1px; }
QTabWidget::pane { border: none; }
QToolTip {
    background-color: #242830;
    color: #E6E8EC;
    border: 1px solid #454B58;
    padding: 4px;
}
QCheckBox, QRadioButton { color: #E6E8EC; }
QCheckBox::indicator, QRadioButton::indicator { width: 14px; height: 14px; }
QProgressBar {
    background-color: #242830;
    border: 1px solid #333842;
    border-radius: 4px;
    text-align: center;
}
QProgressBar::chunk { background-color: #4C8DFF; border-radius: 4px; }
QScrollBar:vertical { background: #14161A; width: 10px; }
QScrollBar::handle:vertical { background: #454B58; border-radius: 4px; }
